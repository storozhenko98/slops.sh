{
  "name": "slops",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "bin": {
    "slops": "./src/index.tsx"
  },
  "scripts": {
    "dev": "bun run src/index.tsx",
    "build": "bun build src/index.tsx --target=bun --outdir dist",
    "compile": "bun build src/index.tsx --compile --outfile dist/slops",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@opentui/core": "^0.3.0",
    "@opentui/react": "^0.3.0",
    "@slops/game": "workspace:*",
    "react": "^19.2.6"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "typescript": "^5.9.3"
  }
}
